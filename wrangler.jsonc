{
  "name": "formeasy",
  "compatibility_date": "2026-09-23",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "formeasy-db",
      "database_id": "YOUR_DATABASE_ID_HERE"
    }
  ]
}
